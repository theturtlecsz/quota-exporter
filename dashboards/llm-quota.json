{
  "uid": "llm-quota",
  "title": "LLM Subscription Quotas",
  "tags": [
    "llm",
    "quota"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "refresh": "5m",
  "schemaVersion": 39,
  "panels": [
    {
      "type": "stat",
      "title": "anthropic \u2014 left in tightest window",
      "id": 1,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(1, 1 - llm_quota_utilization_ratio{provider=\"anthropic\", scope=\"all\"})",
          "legendFormat": "{{window}} window",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 60,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst window utilization"
    },
    {
      "type": "stat",
      "title": "openai \u2014 left in tightest window",
      "id": 2,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 5,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(1, 1 - llm_quota_utilization_ratio{provider=\"openai\", scope=\"all\"})",
          "legendFormat": "{{window}} window",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 60,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst window utilization"
    },
    {
      "type": "stat",
      "title": "gemini \u2014 left in tightest window",
      "id": 3,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 10,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(1, 1 - label_replace(llm_quota_utilization_ratio{provider=\"gemini\", window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\"))",
          "legendFormat": "{{window}} window",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 60,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst window utilization"
    },
    {
      "type": "stat",
      "title": "kimi \u2014 left in tightest window",
      "id": 5,
      "gridPos": {
        "h": 5,
        "w": 5,
        "x": 15,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "bottomk(1, 1 - llm_quota_utilization_ratio{provider=\"kimi\", scope=\"all\"})",
          "legendFormat": "{{window}} window",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        },
        "text": {
          "valueSize": 60,
          "titleSize": 14
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 0,
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Worst window utilization"
    },
    {
      "type": "stat",
      "title": "next reset",
      "id": 6,
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 20,
        "y": 0
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "bottomk(1, (llm_quota_reset_timestamp_seconds{scope=\"all\"} >= time()) * 1000)",
          "legendFormat": "{{provider}} \u00b7 {{window}}"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeAsLocal",
          "decimals": 1
        },
        "overrides": []
      },
      "description": "Soonest quota window reset"
    },
    {
      "type": "table",
      "title": "Quota windows \u2014 remaining",
      "id": 7,
      "gridPos": {
        "h": 9,
        "w": 14,
        "x": 0,
        "y": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "1 - (max by (provider, window) (llm_quota_utilization_ratio{scope=\"all\"} or label_replace(llm_quota_utilization_ratio{provider=\"gemini\",window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\")))",
          "format": "table"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "(max by (provider, window) (llm_quota_reset_timestamp_seconds{scope=\"all\"} or label_replace(llm_quota_reset_timestamp_seconds{provider=\"gemini\",window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\"))) * 1000",
          "format": "table"
        },
        {
          "refId": "C",
          "instant": true,
          "expr": "clamp_max(clamp_min(1 - ((max by (provider, window) (llm_quota_utilization_ratio{scope=\"all\"} or label_replace(llm_quota_utilization_ratio{provider=\"gemini\",window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\"))) + deriv((max by (provider, window) (llm_quota_utilization_ratio{scope=\"all\"} or label_replace(llm_quota_utilization_ratio{provider=\"gemini\",window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\")))[1h:60s]) * clamp_min((max by (provider, window) (llm_quota_reset_timestamp_seconds{scope=\"all\"} or label_replace(llm_quota_reset_timestamp_seconds{provider=\"gemini\",window=\"bucket\"}, \"window\", \"daily\", \"window\", \"bucket\"))) - time(), 0)), 0), 1)",
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "scope": true
            },
            "renameByName": {
              "Value #A": "left",
              "Value #B": "resets at",
              "Value #C": "\u2192 at reset"
            },
            "indexByName": {
              "provider": 0,
              "window": 1,
              "left": 2,
              "\u2192 at reset": 3,
              "resets at": 4
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "used",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": false
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "left"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "max",
                "value": 1
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "red",
                      "value": null
                    },
                    {
                      "color": "#eda100",
                      "value": 0.1
                    },
                    {
                      "color": "green",
                      "value": 0.3
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient",
                  "valueDisplayMode": "color"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "resets at"
            },
            "properties": [
              {
                "id": "unit",
                "value": "dateTimeAsLocal"
              },
              {
                "id": "custom.width",
                "value": 190
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "provider"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "window"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 110
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "\u2192 at reset"
            },
            "properties": [
              {
                "id": "unit",
                "value": "percentunit"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "custom.width",
                "value": 100
              }
            ]
          }
        ]
      }
    },
    {
      "type": "bargauge",
      "title": "Model caps \u2014 remaining",
      "id": 8,
      "gridPos": {
        "h": 9,
        "w": 10,
        "x": 14,
        "y": 9
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sort(1 - llm_quota_utilization_ratio{scope!=\"all\"})",
          "legendFormat": "{{provider}} \u00b7 {{scope}}"
        }
      ],
      "options": {
        "displayMode": "basic",
        "orientation": "horizontal",
        "valueMode": "color",
        "showUnfilled": true,
        "namePlacement": "top",
        "sizing": "auto",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "#eda100",
                "value": 0.1
              },
              {
                "color": "green",
                "value": 0.3
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Model-scoped weekly caps and feature quotas"
    },
    {
      "type": "table",
      "title": "Exporter",
      "id": 11,
      "gridPos": {
        "h": 8,
        "w": 16,
        "x": 0,
        "y": 35
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "llm_quota_scrape_success"
        },
        {
          "refId": "B",
          "instant": true,
          "expr": "time() - llm_quota_last_success_timestamp_seconds"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "llm_quota_scrape_success": "status",
              "Value #A": "status",
              "Value": "data age",
              "Value #B": "data age"
            },
            "indexByName": {
              "provider": 0,
              "status": 1,
              "data age": 2
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "status"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "0": {
                        "text": "\u2717 failing",
                        "color": "red"
                      },
                      "1": {
                        "text": "\u2713 ok",
                        "color": "green"
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "data age"
            },
            "properties": [
              {
                "id": "unit",
                "value": "s"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "#eda100",
                      "value": 900
                    },
                    {
                      "color": "red",
                      "value": 3600
                    }
                  ]
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-text"
                }
              }
            ]
          }
        ]
      }
    },
    {
      "type": "table",
      "title": "Plans",
      "id": 12,
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 35
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "llm_provider_info"
        }
      ],
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true,
              "Value": true,
              "llm_provider_info": true
            },
            "indexByName": {
              "provider": 0,
              "plan": 1,
              "tier": 2
            }
          }
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": []
      }
    },
    {
      "type": "table",
      "title": "Tokens by model",
      "id": 13,
      "description": "Sum of per-session token totals over the dashboard range (all token types)",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 27
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "expr": "sort_desc(sum by (model) (last_over_time({__name__=~\"(claude_code|grok_code|gemini_cli)_token_usage_tokens_total\"}[$__range])))"
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "tokens",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "left",
            "cellOptions": {
              "type": "auto"
            }
          }
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "tokens"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              },
              {
                "id": "min",
                "value": 0
              },
              {
                "id": "color",
                "value": {
                  "mode": "fixed",
                  "fixedColor": "#3987e5"
                }
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "gauge",
                  "mode": "gradient"
                }
              }
            ]
          }
        ]
      },
      "transformations": [
        {
          "id": "labelsToFields",
          "options": {}
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "Value": "tokens",
              "Value #A": "tokens"
            },
            "indexByName": {
              "model": 0,
              "tokens": 1
            }
          }
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Session tokens by model",
      "id": 14,
      "description": "Per-session token totals in a trailing 30 m window \u2014 bursts show tool activity",
      "gridPos": {
        "h": 8,
        "w": 10,
        "x": 8,
        "y": 27
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "interval": "1m",
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (last_over_time({__name__=~\"(claude_code|grok_code|gemini_cli)_token_usage_tokens_total\"}[30m]))",
          "legendFormat": "{{model}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineWidth": 1,
            "fillOpacity": 35,
            "gradientMode": "opacity",
            "stacking": {
              "mode": "normal"
            },
            "showPoints": "never",
            "spanNulls": 900000
          }
        },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "Cost & sessions (claude)",
      "id": 15,
      "description": "Estimated API-equivalent cost and session count over the range",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 27
      },
      "datasource": {
        "type": "datasource",
        "uid": "${datasource}"
      },
      "targets": [
        {
          "refId": "A",
          "instant": true,
          "legendFormat": "cost",
          "expr": "sum(last_over_time(claude_code_cost_usage_USD_total[$__range]))"
        },
        {
          "refId": "B",
          "instant": true,
          "legendFormat": "sessions",
          "expr": "sum(last_over_time(claude_code_session_count_total[$__range]))"
        }
      ],
      "options": {
        "colorMode": "none",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto",
        "textMode": "value_and_name",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "decimals": 1
        },
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "cost"
            },
            "properties": [
              {
                "id": "unit",
                "value": "currencyUSD"
              },
              {
                "id": "decimals",
                "value": 2
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "sessions"
            },
            "properties": [
              {
                "id": "unit",
                "value": "short"
              },
              {
                "id": "decimals",
                "value": 0
              }
